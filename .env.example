# NVR Central environment. Copy to .env with:  python scripts/init-env.py
# That script fills every blank secret with a fresh random value. Never commit .env.

# development | production. Production refuses to start with COOKIE_SECURE=false.
ENVIRONMENT=development

# --- PostgreSQL (docker-compose "db" service) ---
POSTGRES_USER=nvr_central
POSTGRES_PASSWORD=
POSTGRES_DB=nvr_central
# Host ports are bound to 127.0.0.1 only. 5432/6379 are often taken on dev PCs, so we use high ports.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# SQLAlchemy URL used by the backend when run on the host (not in Docker).
# Inside Docker the compose file overrides the host/port to db:5432.
DATABASE_URL=

# --- Backend secrets ---
# Signs access tokens. 32+ random characters.
SECRET_KEY=
# Fernet key (urlsafe base64, 32 bytes). Encrypts NVR passwords and serials at rest.
# LOSING THIS KEY MAKES STORED NVR CREDENTIALS UNRECOVERABLE. Back it up separately from the database.
ENCRYPTION_KEY=

# --- Sessions / cookies ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Must be true behind HTTPS (production). False only for http://localhost development.
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# --- Login protection ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT_PER_MINUTE=20
