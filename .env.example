# NVR Central environment. Copy to .env with:  python scripts/init-env.py
# That script fills every blank secret with a fresh random value. Never commit .env.

# development | production. Production refuses to start with COOKIE_SECURE=false.
ENVIRONMENT=development

# --- PostgreSQL (docker-compose "db" service) ---
POSTGRES_USER=nvr_central
POSTGRES_PASSWORD=
POSTGRES_DB=nvr_central
# Host ports are bound to 127.0.0.1 only. 5432/6379 are often taken on dev PCs, and Windows reserves random ports above 49152, so we use 15432/16379.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# SQLAlchemy URL used by the backend when run on the host (not in Docker).
# Inside Docker the compose file overrides the host/port to db:5432.
DATABASE_URL=

# --- Backend secrets ---
# Signs access tokens. 32+ random characters.
SECRET_KEY=
# Fernet key (urlsafe base64, 32 bytes). Encrypts NVR passwords and serials at rest.
# LOSING THIS KEY MAKES STORED NVR CREDENTIALS UNRECOVERABLE. Back it up separately from the database.
ENCRYPTION_KEY=

# --- Sessions / cookies ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Must be true behind HTTPS (production). False only for http://localhost development.
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# --- Login protection ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_LIMIT_PER_MINUTE=20

# --- Redis / background workers ---
# Celery broker. Filled by scripts/init-env.py. Inside Docker the compose file points this at redis:6379.
REDIS_URL=

# --- WireGuard tunnel hub (campus connectivity) ---
# Hub private key (generated by scripts/init-env.py). Its public key is shown on the Connectivity page.
WG_HUB_PRIVATE_KEY=
# Public host:port campuses connect to, e.g. vpn.example.com:51820. Blank until a hub is deployed.
WG_HUB_ENDPOINT=
# Interface name on the hub, used when reading tunnel health with `wg show`.
WG_INTERFACE=wg0
# Optional: where the app writes the hub wg0.conf whenever peers change (mounted into the hub container).
WG_HUB_CONF_PATH=

# Development only: allow NVR address 127.0.0.1 so scripts/sim_nvr.py works. Refused when ENVIRONMENT=production.
ALLOW_LOOPBACK_NVR_HOSTS=false

# --- Live viewing (MediaMTX gateway, docker-compose "mediamtx" service) ---
# Only the backend talks to these. Browsers never reach MediaMTX; the backend authorises and proxies the video.
# In Docker the compose file points both at the mediamtx container instead.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_HLS_URL=http://127.0.0.1:8888
# Simultaneous upstream streams one NVR is allowed to serve. Measured: 8 at once worked on the test NVR; 16 is untested.
MAX_STREAMS_PER_NVR=8
MAX_STREAMS_TOTAL=40
# A viewer must send a keepalive within this many seconds or the stream session expires.
STREAM_SESSION_TTL_SECONDS=60
# auto: convert to H.264 only for browsers that cannot play H.265. always / never override.
STREAM_TRANSCODE=auto
