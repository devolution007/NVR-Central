# Copy to p2p-bridge/.env (git-ignored). Never commit real values.

# --- Shared ---
NVR_USERNAME=admin
NVR_PASSWORD=

# --- LAN diagnostic (diag/lan_diag.py) ---
# IP of the NVR as seen from the PC running the test (LAN or VPN address).
NVR_HOST=
# Optional, only if the NVR uses non-default ports
# NVR_HTTP_PORT=80
# NVR_RTSP_PORT=554

# --- P2P diagnostic (diag/p2p_diag.py), failed on first hardware test ---
NVR_SERIAL=
